DISCORD_TOKEN=your_bot_token_here
# Your server ID (makes slash commands appear instantly)
GUILD_ID=
# Role allowed to create/cancel flights (users with Manage Server always can)
STAFF_ROLE_ID=
# Channel where flights are announced
ANNOUNCE_CHANNEL_ID=
# Optional: role pinged on each announcement
PING_ROLE_ID=
# Optional: staff channel for warnings (e.g. a member has DMs closed)
LOG_CHANNEL_ID=
